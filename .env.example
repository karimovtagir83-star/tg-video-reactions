# Данные API приложения пользователя Telegram: my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Отдельный Gemini API key; бесплатный лимит зависит от аккаунта и модели.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Обычные ответы по обращению выключены по умолчанию.
# При включении в Gemini отправляются только очищенное минимальное окно и агрегаты стиля.
AUTO_REPLY_ENABLED=false
# Optional override for recent-sticker replies; defaults to AUTO_REPLY_ENABLED.
# Set AUTO_REPLY_STICKERS_ENABLED=false to keep replies text-only.
REPLY_BACKEND=gemini
# Пустое значение использует GEMINI_MODEL без скрытой смены провайдера.
REPLY_MODEL=
STYLE_PROFILE_PATH=data/style/profile.json
# Точные варианты имени через запятую; пусто выключает этот тип триггера.
OWNER_NAME_ALIASES=
# Numeric Telegram user IDs allowed to issue the exact group command "Ответь ему".
# Empty or invalid values keep this action disabled.
OWNER_COMMAND_SENDER_IDS=
REPLY_CONTEXT_BEFORE=5
REPLY_CONTEXT_AFTER=3
REPLY_WAIT_SECONDS=1
# Только числовые ID групп через запятую; личные чаты и каналы не поддерживаются
ALLOWED_CHAT_IDS=
# Необязательно: BotFather token для личного пульта /pause, /resume, /status.
# Настраивать скрытой командой ./bot.sh set-control-token; не вставлять сюда в чат.
CONTROL_BOT_TOKEN=
